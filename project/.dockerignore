# =============================================================================
# .dockerignore — Controls what is sent to the Docker build context
# Keeps image lean and build fast by excluding unnecessary files
# =============================================================================

# Python cache & bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/

# Virtual environments — NEVER include these
.venv/
venv/
env/
ENV/

# Git metadata — not needed inside container
.git/
.gitignore
.gitattributes

# IDE / editor files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# =============================================================================
# CRITICAL EXCLUSIONS (Large files — would bloat build context massively)
# =============================================================================

# Raw dataset (56 MB CSV — mounted as volume at runtime, not baked in)
datasets/

# Pre-built ML model artifacts (27 MB+ — mounted as volume at runtime)
# These are generated by running pipeline.py, not part of the image
output/

# =============================================================================
# Documentation & CI files (not needed inside runtime container)
# =============================================================================
*.md
*.docx
*.txt
!requirements.txt
!requirements-docker.txt

# GitHub Actions workflows
.github/

# Docker files themselves
Dockerfile*
docker-compose*.yml
.dockerignore

# Test files
tests/
pytest.ini
.flake8
Makefile
