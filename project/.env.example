# =============================================================================
# .env — Environment variable defaults for Docker Compose
# Copy this to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

# Application
APP_ENV=production
APP_VERSION=1.0.0

# Docker Registry credentials (used in CI/CD and local pushes)
DOCKERHUB_USERNAME=shubhamgautam05
DOCKERHUB_IMAGE=skillcluster-ai

# GitHub Container Registry
GHCR_REGISTRY=ghcr.io
GHCR_IMAGE=ghcr.io/shubhamgautam05/skillcluster-ai

# Streamlit configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
